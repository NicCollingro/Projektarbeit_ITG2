# T1  Ganzzahlen - Regressionstest, kommt ohne Float aus
# erwartet:  10 3 3 1 55 30 4

const max = 10;
uint a, b, s, i;
array w[5];

main() {
  a = max;
  b = 3;
  print(a);
  print(b);
  print(a / b);
  print(a % b);

  s = 0;
  for ({ i = 1; }, i <= max, { i = i + 1; }) {
    s = s + i;
  }
  print(s);

  for ({ i = 0; }, i < 5, { i = i + 1; }) {
    w[i] = i * i;
  }
  s = 0;
  for ({ i = 0; }, i < 5, { i = i + 1; }) {
    s = s + w[i];
  }
  print(s);
  print(w[2]);
}
